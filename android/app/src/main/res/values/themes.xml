<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ShowBox" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- The launch theme paints the brand panel before the WebView has anything on screen. -->
    <style name="Theme.ShowBox.Splash" parent="Theme.ShowBox">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

</resources>
